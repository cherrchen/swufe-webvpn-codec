{
  "name": "swufe-webvpn-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "SWUFE WebVPN Bridge desktop app (Electron shell for the local bridge)",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && pnpm run build:preload",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js",
    "start": "pnpm run build && electron .",
    "dev:renderer": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.preload.json",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:ui": "vitest run"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "antd": "^6.6.5",
    "electron": "^44.4.3",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
