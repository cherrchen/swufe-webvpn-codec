name: SWUFE WebVPN
desc: |-
  把 allowlist 内的校内网站经官方 WebVPN 访问。
  点击首页 Tile 打开网页登录。不要把 Cookie、密码或 MFA 发给任何人。
openUrl: https://webvpn.swufe.edu.cn
author: cherrchen
homepage: https://github.com/cherrchen/swufe-webvpn-codec
icon: network
category: SWUFE
date: 2026-09-24
version: 0.1.2-m2

tiles:
  - name: swufe-webvpn-tile
    interval: 30
    title: SWUFE WebVPN
    # The script replaces this text. If it remains visible, the Tile script
    # has not run (for example because its remote provider failed to load).
    content: 脚本未运行 · 检查远程资源
    icon: network
    url: https://webvpn.swufe.edu.cn

script-providers:
  swufe-webvpn-request:
    url: https://raw.githubusercontent.com/cherrchen/swufe-webvpn-codec/main/plugins/stash/dist/request.js?v=0.1.2-m2
    interval: 86400
  swufe-webvpn-response:
    url: https://raw.githubusercontent.com/cherrchen/swufe-webvpn-codec/main/plugins/stash/dist/response.js?v=0.1.2-m2
    interval: 86400
  swufe-webvpn-tile:
    url: https://raw.githubusercontent.com/cherrchen/swufe-webvpn-codec/main/plugins/stash/dist/tile.js?v=0.1.2-m2
    interval: 86400

# HTTP/3 does not enter the Stash HTTP Engine. Reject QUIC only for these hosts
# so clients fall back to TCP. Do not also list :443 under force-http-engine:
# that kept HTTPS out of the HTTP script and Safari failed the TLS handshake.
rules:
  - AND,((DOMAIN,jwxt.swufe.edu.cn),(PROTOCOL,QUIC)),REJECT
  - AND,((DOMAIN,webvpn.swufe.edu.cn),(PROTOCOL,QUIC)),REJECT
  - AND,((DOMAIN,authserver.swufe.edu.cn),(PROTOCOL,QUIC)),REJECT

http:
  # Safari's plain-HTTP jwxt entry may arrive through Stash Tunnel. Port 80
  # needs the HTTP Engine for request/response scripts to run.
  force-http-engine:
    - jwxt.swufe.edu.cn:80
  mitm:
    - jwxt.swufe.edu.cn:443
    - webvpn.swufe.edu.cn:443
    - authserver.swufe.edu.cn:443
  script:
    - match: ^https?:\/\/(jwxt|webvpn|authserver)\.swufe\.edu\.cn
      name: swufe-webvpn-request
      type: request
      require-body: false
      timeout: 10
    - match: ^https?:\/\/(jwxt|webvpn|authserver)\.swufe\.edu\.cn
      name: swufe-webvpn-response
      type: response
      require-body: true
      timeout: 15
