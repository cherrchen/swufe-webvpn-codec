# EditorConfig — https://editorconfig.org
# Applies to every file type in this repository. Keep it minimal: this repo is Markdown-first.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing spaces are meaningful in Markdown (hard line breaks) and tables of diff output stay readable.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
